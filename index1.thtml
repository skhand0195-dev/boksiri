cat > /mnt/user-data/outputs/boksiri.html << 'HTMLEOF'
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>똘똘한 복실이</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nanum+Gothic:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { font-family: 'Nanum Gothic', sans-serif; background-color: #fcf8f2; color: #4a3f35; user-select: none; padding-bottom: 30px; }
        .app-header { background-color: #8d7b68; color: white; padding: 18px 10px; border-bottom: 4px solid #6f5f51; }
        .mic-signal-bar { background-color: #e2d9cf; padding: 8px; font-size: 0.95rem; font-weight: bold; text-align: center; border-bottom: 2px solid #d4c5b9; }
        .signal-dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
        .sig-red { background-color: #dc3545; animation: blink 1s infinite alternate; }
        .sig-yellow { background-color: #ffc107; }
        .sig-green { background-color: #28a745; animation: pulse-green 1.2s infinite; }
        @keyframes blink { from { opacity:0.4; } to { opacity:1; } }
        @keyframes pulse-green { 0%{box-shadow:0 0 0 0 rgba(40,167,69,0.7);}70%{box-shadow:0 0 0 10px rgba(40,167,69,0);}100%{box-shadow:0 0 0 0 rgba(40,167,69,0);} }
        .boksiri-container { display:flex; justify-content:center; align-items:center; margin:30px 0; }
        .boksiri-btn { width:200px; height:200px; border-radius:50%; background-color:#fdd835; border:8px solid #8d7b68; display:flex; flex-direction:column; justify-content:center; align-items:center; cursor:pointer; transition:all 0.25s ease; }
        .boksiri-btn:active { transform:scale(0.92); }
        .boksiri-btn.active { background-color:#e03131!important; border-color:#c92a2a!important; }
        .boksiri-btn img { width:110px; height:110px; object-fit:contain; }
        .status-box { background-color:white; border:3px solid #e2d9cf; border-radius:20px; padding:20px; margin:16px 15px; min-height:160px; display:flex; align-items:center; justify-content:center; }
        .status-text { font-size:1.6rem; font-weight:800; line-height:1.6; word-break:keep-all; }
        #mic-permission-banner { display:none; background:#fff3cd; border:2px solid #ffc107; border-radius:12px; margin:10px 15px; padding:14px 16px; font-size:1.05rem; font-weight:700; color:#7d5a00; text-align:center; }
        #mic-permission-banner button { margin-top:10px; font-size:1.05rem; font-weight:800; padding:10px 28px; border-radius:30px; border:none; background:#ffc107; color:#3d2e00; cursor:pointer; }

        /* 유튜브 선택 모달 */
        #youtube-modal { display:none; position:fixed; top:0;left:0;width:100%;height:100%; background:rgba(0,0,0,0.75); z-index:3000; align-items:center; justify-content:center; flex-direction:column; }
        .yt-modal-box { background:white; border-radius:24px; padding:28px 20px; width:90%; max-width:380px; text-align:center; }
        .yt-modal-box h3 { font-size:1.5rem; font-weight:800; margin-bottom:6px; }
        .yt-modal-box p { font-size:1rem; color:#666; margin-bottom:20px; }
        .yt-btn { display:block; width:100%; padding:16px; font-size:1.3rem; font-weight:800; border-radius:16px; border:none; cursor:pointer; margin-bottom:12px; }
        .yt-btn-open { background:#ff0000; color:white; }
        .yt-btn-search { background:#333; color:white; }
        .yt-btn-cancel { background:#e2d9cf; color:#4a3f35; }

        #settingsModal { display:none; position:fixed; top:0;left:0;width:100%;height:100%; background:rgba(0,0,0,0.6); z-index:2000; align-items:center; justify-content:center; backdrop-filter:blur(5px); }
    </style>
</head>
<body>
    <header class="app-header text-center position-relative">
        <h1 class="fw-bold m-0" style="font-size:2rem;">🐶 똘똘한 복실이</h1>
        <button class="btn btn-sm btn-outline-light position-absolute" style="top:18px;right:15px;font-weight:bold;" onclick="openSettings()"><i class="bi bi-gear-fill"></i> 설정</button>
    </header>

    <div class="mic-signal-bar" id="signal-bar">
        <span class="signal-dot sig-yellow" id="signal-dot"></span>
        <span id="signal-text" class="text-warning">마이크 준비 중... 복실이를 터치해 주세요!</span>
    </div>

    <div id="mic-permission-banner">
        📵 마이크 사용이 차단되어 있어요!<br>
        아래 버튼을 눌러 마이크를 다시 허용해 주세요.
        <br><button onclick="requestMicPermission()">🎙 마이크 허용하기</button>
        <br><span style="font-size:0.8rem;margin-top:6px;display:block;">※ 안 되면: 주소창 왼쪽 🔒 → 마이크 → 허용 → 새로고침</span>
    </div>

    <main class="container" id="main-content">
        <div class="status-box text-center">
            <span class="status-text text-success" id="status-display">복실아 라고 불러주거나 아래 복실이를 눌러주세요</span>
        </div>
        <div class="boksiri-container">
            <button class="boksiri-btn" id="boksiri-main-btn" onclick="toggleBoksiri()">
                <img src="https://cdn-icons-png.flaticon.com/512/616/616408.png" alt="복실이">
                <span class="fw-bold mt-2 text-dark" style="font-size:1.1rem;" id="btn-text">복실이 부르기</span>
            </button>
        </div>
    </main>

    <!-- 유튜브 선택 모달 (앱으로 열기 / 검색으로 열기) -->
    <div id="youtube-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.75);z-index:3000;align-items:center;justify-content:center;">
        <div class="yt-modal-box">
            <h3>🎵 노래 재생</h3>
            <p id="yt-song-title" style="font-size:1.1rem;font-weight:800;color:#333;margin-bottom:6px;"></p>
            <p>어떻게 재생할까요?</p>
            <button class="yt-btn yt-btn-open" onclick="openYoutubeApp()">📱 유튜브 앱으로 열기<br><span style="font-size:0.85rem;font-weight:400;">(가장 잘 들려요)</span></button>
            <button class="yt-btn yt-btn-search" onclick="openYoutubeSearch()">🔍 유튜브 검색으로 열기<br><span style="font-size:0.85rem;font-weight:400;">(앱이 없을 때)</span></button>
            <button class="yt-btn yt-btn-cancel" onclick="closeYoutubeModal()">취소</button>
        </div>
    </div>

    <!-- 설정 모달 -->
    <div id="settingsModal">
        <div class="card p-4 mx-3 shadow" style="width:100%;max-width:420px;background:white;border-radius:20px;max-height:90vh;overflow-y:auto;">
            <h4 class="fw-bold text-center border-bottom pb-2 mb-3">⚙ 초기 환경 설정</h4>
            <div class="mb-3 border-bottom pb-3">
                <h6 class="fw-bold text-primary"><i class="bi bi-person-badge-fill"></i> 1. 맞춤형 호칭 및 음성 설정</h6>
                <div class="row g-2 mt-2">
                    <div class="col-6">
                        <label class="form-label small fw-bold">상대방 호칭</label>
                        <select class="form-select form-select-sm" id="user-title">
                            <option value="할아버지" selected>할아버지 👴</option>
                            <option value="할머니">할머니 👵</option>
                            <option value="아저씨">아저씨 👨</option>
                            <option value="아주머니">아주머니 👩</option>
                            <option value="형님">형님 👨</option>
                            <option value="누님">누님 👩</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">복실이 목소리</label>
                        <select class="form-select form-select-sm" id="voice-gender">
                            <option value="granddaughter" selected>상냥한 여성 (손녀)</option>
                            <option value="grandson">상냥한 남성 (손자)</option>
                            <option value="woman30">30대 여성</option>
                            <option value="man30">30대 남성</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="mb-3 border-bottom pb-3">
                <h6 class="fw-bold text-success"><i class="bi bi-telephone-fill"></i> 2. 복실이 전용 전화번호부</h6>
                <div id="contact-list-container" class="mb-2" style="max-height:120px;overflow-y:auto;"></div>
                <div class="row g-1">
                    <div class="col-4"><input type="text" class="form-control form-control-sm" id="new-contact-name" placeholder="호칭(예: 아들)"></div>
                    <div class="col-6"><input type="tel" class="form-control form-control-sm" id="new-contact-phone" placeholder="전화번호(- 제외)"></div>
                    <div class="col-2"><button class="btn btn-sm btn-success w-100" onclick="addNewContact()">등록</button></div>
                </div>
            </div>
            <div class="mb-3">
                <h6 class="fw-bold text-secondary"><i class="bi bi-cpu-fill"></i> 3. AI 키 설정 (선택사항)</h6>
                <p class="text-muted" style="font-size:0.7rem;">키 없이도 복실이 기본 대화는 가능해요. 더 똑똑하게 하려면 입력하세요.</p>
                <div class="mb-2">
                    <label class="form-label small fw-bold" style="font-size:0.7rem;">구글 제미나이 키</label>
                    <input type="password" class="form-control form-control-sm" id="key-gemini" placeholder="AI Studio Key 입력">
                </div>
                <div>
                    <label class="form-label small fw-bold" style="font-size:0.7rem;">OpenAI 챗GPT 키</label>
                    <input type="password" class="form-control form-control-sm" id="key-chatgpt" placeholder="sk-... 입력">
                </div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-6"><button class="btn btn-secondary w-100 py-2 fw-bold btn-sm" onclick="closeSettings()">취소</button></div>
                <div class="col-6"><button class="btn btn-warning w-100 py-2 fw-bold btn-sm" onclick="saveSettings()">저장하기</button></div>
            </div>
        </div>
    </div>

    <script>
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognition = null;
    let isActiveState = false;
    let isRecognitionRunning = false;
    let speakTimer = null;
    let inactivityTimer = null;
    let isConfirmingCall = false;
    let pendingPhoneNumber = "";
    let pendingPhoneName = "";
    let isConfirmingTaxi = false;
    let taxiStart = "";
    let taxiDest = "";
    window.currentAiText = "";
    let pendingYoutubeSong = "";

    // ✅ let으로 선언 (재할당 가능)
    let SYSTEM_PROMPT = "";

    let configData = {
        userTitle: "할아버지",
        voiceGender: "granddaughter",
        contacts: [{ name: "아들", phone: "" }, { name: "딸", phone: "" }],
        geminiKey: "",
        chatgptKey: ""
    };

    // ========== 마이크 권한 ==========
    async function requestMicPermission() {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            stream.getTracks().forEach(t => t.stop());
            document.getElementById('mic-permission-banner').style.display = 'none';
            updateSignal('yellow', '마이크 허용됨! 복실이를 터치해 주세요.');
            if (!recognition) initVoiceEngine();
            else restartMicSafely();
        } catch(e) {
            updateSignal('red', '마이크 차단됨 - 브라우저 설정에서 직접 허용해 주세요');
            document.getElementById('mic-permission-banner').style.display = 'block';
        }
    }

    async function checkMicPermissionStatus() {
        if (!navigator.permissions) return;
        try {
            const result = await navigator.permissions.query({ name: 'microphone' });
            if (result.state === 'denied') {
                document.getElementById('mic-permission-banner').style.display = 'block';
                updateSignal('red', '마이크가 차단되어 있습니다. 위 버튼을 눌러 허용해 주세요.');
            } else if (result.state === 'prompt') {
                requestMicPermission();
            }
            result.onchange = function() {
                if (result.state === 'granted') {
                    document.getElementById('mic-permission-banner').style.display = 'none';
                    updateSignal('yellow', '마이크 허용됨!');
                    if (!recognition) initVoiceEngine(); else restartMicSafely();
                } else if (result.state === 'denied') {
                    document.getElementById('mic-permission-banner').style.display = 'block';
                    updateSignal('red', '마이크가 차단되었습니다.');
                }
            };
        } catch(e) {}
    }

    window.onload = function() {
        loadSettings();
        checkMicPermissionStatus();
        initVoiceEngine();
        updateSignal('yellow', '복실이가 조는 중... 복실이를 한번 터치해 주세요!');
    };

    // ========== 설정 ==========
    function loadSettings() {
        try {
            const saved = localStorage.getItem("boksiri_config_v2");
            if (saved) { const parsed = JSON.parse(saved); configData = { ...configData, ...parsed }; }
        } catch(e) {}
        buildSystemPrompt();
        renderSettingsContacts();
    }

    function buildSystemPrompt() {
        SYSTEM_PROMPT = `너의 이름은 '복실이'이고, 혼자 살아가시는 어르신을 정성껏 돌보는 인공지능 강아지 비서야. 대화 상대방의 호칭은 오직 '${configData.userTitle}' 또는 '${configData.userTitle}님'이야. 대답할 때는 마디마디마다 '${configData.userTitle}님' 또는 '${configData.userTitle}'이라고 다정하게 불러줘. 다른 호칭은 절대 쓰면 안 돼. 친절하고 공손한 한국어 존댓말로 대답해줘. 의학적 판단이 필요할 때는 자가 대처법을 권하되, 가슴이 아프거나 답답하다는 징후에는 즉시 119를 불러야 한다고 강력하게 경고해. 문장은 두세 줄 이내로 짧게 끊어서 말해줘.`;
    }

    function saveSettings() {
        configData.userTitle = document.getElementById('user-title').value;
        configData.voiceGender = document.getElementById('voice-gender').value;
        configData.geminiKey = document.getElementById('key-gemini').value;
        configData.chatgptKey = document.getElementById('key-chatgpt').value;
        try { localStorage.setItem("boksiri_config_v2", JSON.stringify(configData)); } catch(e) {}
        buildSystemPrompt();
        closeSettings();
        alert("모든 설정이 완벽하게 저장되었습니다!");
        resetToIdleState();
    }
    function openSettings() {
        document.getElementById('user-title').value = configData.userTitle || "할아버지";
        document.getElementById('voice-gender').value = configData.voiceGender || "granddaughter";
        document.getElementById('key-gemini').value = configData.geminiKey || "";
        document.getElementById('key-chatgpt').value = configData.chatgptKey || "";
        renderSettingsContacts();
        document.getElementById('settingsModal').style.display = 'flex';
    }
    function closeSettings() { document.getElementById('settingsModal').style.display = 'none'; }
    function renderSettingsContacts() {
        const container = document.getElementById('contact-list-container');
        container.innerHTML = '';
        configData.contacts.forEach((c, index) => {
            const div = document.createElement('div');
            div.className = 'd-flex justify-content-between align-items-center mb-1 bg-light p-1 rounded';
            div.innerHTML = `<span class="small fw-bold">👤 ${c.name} : ${c.phone || "미등록"}</span><button class="btn btn-sm btn-danger py-0 px-1" style="font-size:0.65rem;" onclick="deleteContact(${index})">삭제</button>`;
            container.appendChild(div);
        });
    }
    function addNewContact() {
        const name = document.getElementById('new-contact-name').value.trim();
        const phone = document.getElementById('new-contact-phone').value.trim();
        if (!name || !phone) { alert("이름과 번호를 정확히 입력해 주세요."); return; }
        configData.contacts.push({ name, phone });
        document.getElementById('new-contact-name').value = '';
        document.getElementById('new-contact-phone').value = '';
        renderSettingsContacts();
    }
    function deleteContact(index) { configData.contacts.splice(index, 1); renderSettingsContacts(); }

    // ========== 음성 출력 ==========
    function speak(text) {
        updateSignal('yellow', '복실이가 대답하는 중...');
        window.currentAiText = text;
        if (inactivityTimer) clearTimeout(inactivityTimer);
        if (speakTimer) clearTimeout(speakTimer);
        speakTimer = setTimeout(() => { restartMicSafely(); }, (text.length * 150) + 2000);
        window.speechSynthesis.cancel();
        let safeText = text.replace(/어르신/g, configData.userTitle);
        const utterance = new SpeechSynthesisUtterance(safeText);
        utterance.lang = "ko-KR";
        const voices = window.speechSynthesis.getVoices();
        let selectedVoice = null;
        if (configData.voiceGender === 'granddaughter') {
            selectedVoice = voices.find(v => v.lang === 'ko-KR' && (v.name.includes('Google') || v.name.includes('Yuna') || v.name.includes('Seoyeon')));
            utterance.pitch = 1.25; utterance.rate = 0.95;
        } else if (configData.voiceGender === 'grandson') {
            selectedVoice = voices.find(v => v.lang === 'ko-KR' && (v.name.includes('Minjun') || v.name.includes('male')));
            utterance.pitch = 1.05; utterance.rate = 0.90;
        } else if (configData.voiceGender === 'woman30') {
            selectedVoice = voices.find(v => v.lang === 'ko-KR');
            utterance.pitch = 1.00; utterance.rate = 0.95;
        } else {
            selectedVoice = voices.find(v => v.lang === 'ko-KR' && (v.name.includes('Minjun') || v.name.includes('male')));
            utterance.pitch = 0.85; utterance.rate = 0.92;
        }
        if (!selectedVoice) selectedVoice = voices.find(v => v.lang.startsWith('ko'));
        if (selectedVoice) utterance.voice = selectedVoice;
        utterance.onend = function() {
            if (speakTimer) clearTimeout(speakTimer);
            restartMicSafely();
            if (isActiveState && !isConfirmingCall && !isConfirmingTaxi) startInactivityTimer();
        };
        utterance.onerror = function() {
            if (speakTimer) clearTimeout(speakTimer);
            restartMicSafely();
        };
        setTimeout(() => { window.speechSynthesis.speak(utterance); }, 50);
    }

    function startInactivityTimer() {
        if (inactivityTimer) clearTimeout(inactivityTimer);
        inactivityTimer = setTimeout(() => {
            if (isActiveState && !window.speechSynthesis.speaking) {
                resetToIdleState();
                speak("복실이 잠시 쉬고 있을게요. 필요하시면 다시 불러주세요!");
            }
        }, 15000);
    }

    function restartMicSafely() {
        if (/KAKAOTALK/i.test(navigator.userAgent)) return;
        if (recognition && !isRecognitionRunning) {
            try { recognition.start(); } catch(e) {}
        }
    }

    if (window.speechSynthesis.onvoiceschanged !== undefined) {
        window.speechSynthesis.onvoiceschanged = () => { window.speechSynthesis.getVoices(); };
    }

    function updateSignal(color, text) {
        const dot = document.getElementById('signal-dot');
        const txt = document.getElementById('signal-text');
        const bar = document.getElementById('signal-bar');
        dot.className = "signal-dot"; txt.className = "";
        if (color === 'red') { dot.classList.add('sig-red'); txt.classList.add('text-danger'); bar.style.backgroundColor = '#fce8e6'; }
        else if (color === 'yellow') { dot.classList.add('sig-yellow'); txt.classList.add('text-warning'); bar.style.backgroundColor = '#fef9e7'; }
        else if (color === 'green') { dot.classList.add('sig-green'); txt.classList.add('text-success'); bar.style.backgroundColor = '#eafaf1'; }
        txt.innerText = text;
    }

    // ========== 음성 인식 엔진 ==========
    function initVoiceEngine() {
        if (!SpeechRecognition) { updateSignal('red', '음성 인식 지원 불가 (구글 크롬 권장)'); return; }
        recognition = new SpeechRecognition();
        recognition.continuous = true;
        recognition.interimResults = false;
        recognition.onstart = function() {
            isRecognitionRunning = true;
            document.getElementById('mic-permission-banner').style.display = 'none';
            if (isActiveState) updateSignal('green', '복실이가 듣고 있어요! 이어서 말씀해 보세요.');
            else updateSignal('yellow', '복실이가 조는 중... 복실아 라고 불러주세요!');
        };
        recognition.onspeechstart = function() { if (inactivityTimer) clearTimeout(inactivityTimer); };
        recognition.onerror = function(event) {
            isRecognitionRunning = false;
            if (event.error === 'not-allowed' || event.error === 'service-not-allowed') {
                document.getElementById('mic-permission-banner').style.display = 'block';
                updateSignal('red', '마이크가 차단되어 있어요! 위의 노란 박스를 확인해 주세요.');
            } else if (event.error !== 'aborted') {
                updateSignal('red', `오류: ${event.error} (새로고침해 보세요)`);
            }
        };
        recognition.onresult = function(event) {
            const speechToText = event.results[event.results.length - 1][0].transcript.trim();
            console.log("인식:", speechToText);
            if (isConfirmingCall) { handleCallConfirmation(speechToText); return; }
            if (isConfirmingTaxi) { handleTaxiConfirmation(speechToText); return; }
            if (window.speechSynthesis.speaking) {
                const ai = window.currentAiText || "";
                const isEcho = ai.includes(speechToText) || speechToText.split(" ").every(w => ai.includes(w));
                if (isEcho) return;
                window.speechSynthesis.cancel();
                if (speakTimer) clearTimeout(speakTimer);
            }
            if (!isActiveState) {
                if (speechToText.includes("복실") || speechToText.includes("옥실") || speechToText.includes("목실") || speechToText.includes("혹시")) triggerActiveState();
            } else {
                handleCommand(speechToText);
            }
        };
        recognition.onend = function() {
            isRecognitionRunning = false;
            setTimeout(() => { if (!isRecognitionRunning && !window.speechSynthesis.speaking) restartMicSafely(); }, 300);
        };
        restartMicSafely();
    }

    window.toggleBoksiri = function() {
        if (/KAKAOTALK/i.test(navigator.userAgent)) { alert("카카오톡 창에서는 마이크가 작동하지 않습니다! 다른 브라우저로 열어주세요!"); return; }
        if (!isRecognitionRunning) {
            requestMicPermission().then(() => {
                if (!isActiveState) triggerActiveState();
                else { resetToIdleState(); speak("복실이 이만 물러갑니다. 필요할 때 언제든 다시 불러주세요!"); }
            }).catch(() => {});
            return;
        }
        if (!isActiveState) triggerActiveState();
        else { resetToIdleState(); speak("복실이 이만 물러갑니다. 필요할 때 언제든 다시 불러주세요!"); }
    };

    function triggerActiveState() {
        isActiveState = true;
        document.getElementById('status-display').innerText = "👂 네, 말씀하세요. 듣고 있어요~";
        document.getElementById('status-display').className = "status-text text-danger fw-bold";
        const btn = document.getElementById('boksiri-main-btn');
        btn.classList.add('active');
        document.getElementById('btn-text').innerText = "대화 끝내기";
        document.getElementById('btn-text').className = "fw-bold mt-2 text-white";
        updateSignal('green', '복실이가 듣고 있어요!');
        speak("네, 말씀하세요.");
    }

    function resetToIdleState() {
        isActiveState = false; isConfirmingCall = false; isConfirmingTaxi = false;
        if (inactivityTimer) clearTimeout(inactivityTimer);
        document.getElementById('boksiri-main-btn').classList.remove('active');
        document.getElementById('btn-text').innerText = "복실이 부르기";
        document.getElementById('btn-text').className = "fw-bold mt-2 text-dark";
        document.getElementById('status-display').innerText = '복실아 라고 불러주거나 아래 복실이를 눌러주세요';
        document.getElementById('status-display').className = "status-text text-success";
        updateSignal('yellow', '복실이가 조는 중... 복실이를 한번 터치해 주세요!');
        window.speechSynthesis.cancel();
        setTimeout(restartMicSafely, 300);
    }

    // ========== ✅ 유튜브: 앱/브라우저로 직접 열기 방식 ==========
    function playVideoAutomatically(searchQuery) {
        pendingYoutubeSong = searchQuery;
        document.getElementById('yt-song-title').innerText = `🎵 ${searchQuery}`;
        // 모달 표시
        const modal = document.getElementById('youtube-modal');
        modal.style.display = 'flex';
    }

    function openYoutubeApp() {
        // 유튜브 앱 딥링크 → 없으면 자동으로 브라우저 유튜브로 이동
        const query = encodeURIComponent(pendingYoutubeSong);
        closeYoutubeModal();
        speak("유튜브 앱을 열게요! 잠시만 기다려주세요.");
        setTimeout(() => {
            // 앱 링크 시도 후 2초 뒤 앱이 없으면 브라우저로 fallback
            window.location.href = `youtube://results?search_query=${query}`;
            setTimeout(() => {
                window.open(`https://www.youtube.com/results?search_query=${query}`, '_blank');
            }, 2000);
        }, 1500);
    }

    function openYoutubeSearch() {
        const query = encodeURIComponent(pendingYoutubeSong);
        closeYoutubeModal();
        speak("유튜브 검색 화면을 열게요!");
        setTimeout(() => {
            window.open(`https://www.youtube.com/results?search_query=${query}`, '_blank');
        }, 1500);
    }

    function closeYoutubeModal() {
        document.getElementById('youtube-modal').style.display = 'none';
        pendingYoutubeSong = "";
    }

    // ========== 날씨 ==========
    function interpretWMOCode(code) {
        if (code === 0) return "아주 맑음";
        if ([1,2,3].includes(code)) return "구름 조금 낀 맑은 날씨";
        if ([45,48].includes(code)) return "안개가 자욱한 날씨";
        if ([51,53,55].includes(code)) return "부슬부슬 이슬비가 내리는 날씨";
        if ([61,63,65].includes(code)) return "추적추적 비가 내리는 날씨";
        if ([71,73,75,77].includes(code)) return "눈이 내리는 날씨";
        if ([80,81,82].includes(code)) return "소나기가 쏟아지는 날씨";
        if ([95,96,99].includes(code)) return "천둥 번개가 치는 날씨";
        return "흐린 날씨";
    }

    function fetchLocationAndWeather() {
        speak(`${configData.userTitle}님이 계신 곳의 날씨를 위성으로 알아보고 있어요. 삼초만 기다려주세요!`);
        if (!navigator.geolocation) { speak("스마트폰의 위치 센서가 꺼져 있어서 날씨를 확인할 수 없어요."); return; }
        navigator.geolocation.getCurrentPosition(async (pos) => {
            try {
                const r = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${pos.coords.latitude}&longitude=${pos.coords.longitude}&current=temperature_2m,weather_code&daily=temperature_2m_max,temperature_2m_min,weather_code&timezone=auto`);
                if (!r.ok) throw new Error();
                const d = await r.json();
                const cur = Math.round(d.current.temperature_2m);
                const curW = interpretWMOCode(d.current.weather_code);
                const tmMin = Math.round(d.daily.temperature_2m_min[1]);
                const tmMax = Math.round(d.daily.temperature_2m_max[1]);
                const tmW = interpretWMOCode(d.daily.weather_code[1]);
                document.getElementById('status-display').innerText = `☀ 오늘: ${curW} (${cur}도) / 내일: ${tmW} (${tmMin}~${tmMax}도)`;
                document.getElementById('status-display').className = "status-text text-primary";
                speak(`${configData.userTitle}님! 오늘 날씨는 ${curW}이고 기온은 ${cur}도입니다. 내일은 최저 ${tmMin}도, 최고 ${tmMax}도로 ${tmW}가 예상됩니다. 감기 조심하세요!`);
            } catch(e) { speak("기상청 신호가 일시적으로 끊겼어요. 잠시 후 다시 물어봐 주세요."); }
        }, () => { speak("위치 권한을 허용해 주셔야 날씨를 찾을 수 있어요."); }, { timeout: 10000 });
    }

    // ========== 택시 ==========
    function calculateTaxiDetails(startName, destName) {
        taxiStart = startName; taxiDest = destName;
        let dist = ((startName.length + destName.length) % 15) + 3;
        let time = Math.round(dist * 2.3 + 4);
        let fare = Math.round((4800 + dist * 1100) / 100) * 100;
        isConfirmingTaxi = true;
        document.getElementById('status-display').innerText = `🚕 요금: 약 ${fare.toLocaleString()}원 / ${time}분 예상`;
        document.getElementById('status-display').className = "status-text text-danger fw-bold";
        speak(`${configData.userTitle}님! ${startName}에서 ${destName}까지 택시 요금은 약 ${fare.toLocaleString()}원, 시간은 ${time}분 정도 걸립니다. 카카오 택시를 호출할까요? 맞으면 '어 그래', 아니면 '하지마라' 고 말씀해 주세요.`);
    }

    function handleTaxiConfirmation(text) {
        if (text.includes("응") || text.includes("어") || text.includes("그래") || text.includes("예") || text.includes("네") || text.includes("불러") || text.includes("해라")) {
            speak("카카오 택시 앱을 열게요!");
            setTimeout(() => {
                window.location.href = `kakaot://taxi?dest_name=${encodeURIComponent(taxiDest)}`;
                setTimeout(() => { if (!document.hidden) window.location.href = "https://t.kakao.com"; }, 2000);
                resetToIdleState();
            }, 3000);
        } else if (text.includes("하지") || text.includes("안해") || text.includes("취소") || text.includes("아니")) {
            speak("택시 호출을 취소했습니다."); resetToIdleState();
        } else {
            speak("잘 못 알아들었어요. 택시를 부를까요? '어 그래' 또는 '하지마라' 고 말씀해 주세요.");
        }
    }

    // ========== ✅ AI 대화: Claude API 내장 → Gemini → ChatGPT → 로컬 순서 ==========
    async function askClaude(userMessage) {
        const response = await fetch("https://api.anthropic.com/v1/messages", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                model: "claude-sonnet-4-6",
                max_tokens: 200,
                system: SYSTEM_PROMPT,
                messages: [{ role: "user", content: userMessage }]
            })
        });
        if (!response.ok) throw new Error("Claude API 에러");
        const data = await response.json();
        return data.content[0].text;
    }

    async function askGemini(userMessage) {
        const key = (configData.geminiKey || "").trim();
        if (!key || key.length < 10) throw new Error("키 없음");
        const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${key}`;
        const r = await fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ contents: [{ parts: [{ text: `${SYSTEM_PROMPT}\n\n질문: ${userMessage}` }] }] })
        });
        if (!r.ok) throw new Error("Gemini 에러");
        const d = await r.json();
        return d.candidates[0].content.parts[0].text;
    }

    async function askChatGPT(userMessage) {
        const key = (configData.chatgptKey || "").trim();
        if (!key || key.length < 10) throw new Error("키 없음");
        const r = await fetch("https://api.openai.com/v1/chat/completions", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Authorization": `Bearer ${key}` },
            body: JSON.stringify({ model: "gpt-4o-mini", messages: [{ role: "system", content: SYSTEM_PROMPT }, { role: "user", content: userMessage }], max_tokens: 150 })
        });
        if (!r.ok) throw new Error("ChatGPT 에러");
        const d = await r.json();
        return d.choices[0].message.content;
    }

    async function runAI(userMessage) {
        document.getElementById('status-display').innerText = "🤔 생각 중입니다...";
        // 1순위: Claude 내장 API
        try { return await askClaude(userMessage); } catch(e1) {}
        // 2순위: Gemini (키 있을 때)
        try { return await askGemini(userMessage); } catch(e2) {}
        // 3순위: ChatGPT (키 있을 때)
        try { return await askChatGPT(userMessage); } catch(e3) {}
        // 4순위: 로컬 규칙
        return runLocalFallback(userMessage);
    }

    function runLocalFallback(command) {
        if (command.includes("심심") || command.includes("지루") || command.includes("놀아")) {
            setTimeout(() => playVideoAutomatically("신나는 트로트 메들리"), 2000);
            return "제가 좋아하는 트로트 메들리를 찾아드릴게요!";
        }
        if (command.includes("외롭") || command.includes("쓸쓸") || command.includes("혼자")) return `${configData.userTitle}님, 외로워하지 마세요. 복실이가 늘 곁에 있을게요!`;
        if (command.includes("머리") || command.includes("두통") || command.includes("어지러")) return `아이고 머리가 아프시군요 ${configData.userTitle}님. 따뜻한 물 한잔 드시고 가만히 쉬어보세요.`;
        if (command.includes("가슴") || command.includes("답답") || command.includes("숨")) return `경고합니다 ${configData.userTitle}님! 가슴이 답답하신 건 위험한 신호입니다! 즉시 119를 부르세요!`;
        if (command.includes("배") || command.includes("복통") || command.includes("소화")) return "배를 따뜻하게 하시고 시계 방향으로 살살 문질러 주시면 편해지실 겁니다.";
        return `${configData.userTitle}님, 제가 잘 이해하지 못했어요. '날씨 어때', '노래 틀어줘' 처럼 간단하게 다시 말씀해 주세요.`;
    }

    // ========== 전화 ==========
    function triggerCallConfirmation(phoneName, phoneNumber) {
        isConfirmingCall = true; pendingPhoneNumber = phoneNumber; pendingPhoneName = phoneName;
        document.getElementById('status-display').innerText = `📞 ${phoneName}에게 전화할까요?`;
        document.getElementById('status-display').className = "status-text text-danger fw-bold";
        speak(`${phoneName}에게 전화를 걸어드릴까요? 전화하려면 '어 그래', 취소하려면 '하지마라' 고 말씀해 주세요.`);
    }

    function handleCallConfirmation(text) {
        if (text.includes("응") || text.includes("어") || text.includes("그래") || text.includes("해라") || text.includes("예") || text.includes("네") || text.includes("맞아")) {
            speak(`${pendingPhoneName}에게 전화를 연결합니다.`);
            setTimeout(() => { window.location.href = `tel:${pendingPhoneNumber}`; resetToIdleState(); }, 2500);
        } else if (text.includes("하지") || text.includes("안해") || text.includes("취소") || text.includes("아니")) {
            speak("전화 연결을 취소했습니다."); resetToIdleState();
        } else {
            speak("잘 못 알아들었어요. '어 그래' 또는 '하지마라' 라고 말씀해 주세요.");
        }
    }

    // ========== 핵심 명령 처리 ==========
    async function handleCommand(command) {
        // 긴급
        if (command.includes("경찰") || command.includes("112")) { triggerCallConfirmation("경찰서 일일이", "112"); return; }
        if (command.includes("소방서") || command.includes("119") || command.includes("불났") || command.includes("구급차")) { triggerCallConfirmation("소방서 일일구", "119"); return; }
        // 날씨
        if (command.includes("날씨") || command.includes("비오냐") || command.includes("비가") || command.includes("눈오냐") || command.includes("덥냐") || command.includes("춥냐") || command.includes("기온")) { fetchLocationAndWeather(); return; }
        // 택시
        if (command.includes("택시") || command.includes("카카오택시") || command.includes("차 불러")) {
            const m = command.match(/(.+)에서\s*(.+)까지/) || command.match(/(.+)부터\s*(.+)까지/);
            if (m) calculateTaxiDetails(m[1].replace("복실아","").trim(), m[2].replace("택시","").replace("불러","").trim());
            else speak("어디서 어디까지 가시나요? 예를 들어 '집에서 병원까지' 처럼 말씀해 주세요.");
            return;
        }
        // 경로 입력
        if (isConfirmingTaxi === false && (command.includes("에서") && command.includes("까지"))) {
            const m = command.match(/(.+)에서\s*(.+)까지/);
            if (m) { calculateTaxiDetails(m[1].trim(), m[2].trim()); return; }
        }
        // 노래
        if (command.includes("노래") || command.includes("음악") || command.includes("트로트") || command.includes("틀어") || command.includes("들려")) {
            let song = command.replace(/복실아|노래|음악|트로트|틀어줘|틀어|들려줘|들려|재생/g, "").trim();
            if (!song) song = "신나는 트로트 메들리";
            speak(`네! ${song} 찾아드릴게요!`);
            setTimeout(() => playVideoAutomatically(song), 2000);
            return;
        }
        // 전화번호부 검색
        for (let c of configData.contacts) {
            if (c.phone && command.includes(c.name)) { triggerCallConfirmation(c.name, c.phone); return; }
        }
        // 시간
        if (command.includes("시간") || command.includes("몇 시") || command.includes("시냐")) {
            const now = new Date();
            const h = now.getHours(); const m = now.getMinutes();
            speak(`지금은 ${h >= 12 ? '오후' : '오전'} ${h % 12 || 12}시 ${m}분입니다. 약 챙겨 드세요!`);
            return;
        }
        // AI 대화
        try {
            const reply = await runAI(command);
            document.getElementById('status-display').innerText = "👂 듣고 있어요...";
            speak(reply);
        } catch(e) {
            speak("죄송해요, 잘 알아듣지 못했어요. 다시 한번 말씀해 주세요.");
            resetToIdleState();
        }
    }
    </script>
</body>
</html>
HTMLEOF
echo "완료"